# Copy this file to .env and fill in your own values. .env is gitignored —
# never commit real keys.
#
# This is a dev/test-time convenience only, used by the live smoke tests (see
# README.md, `npm run test:live` — they hit real APIs and cost real money). The
# shipped app never reads API keys from env vars: user-supplied keys are stored
# in the OS keychain at runtime (PRD §8), never in a file.
#
# Naming convention (PRD §14.1): <PROVIDER>_API_KEY / <PROVIDER>_DEFAULT_MODEL,
# where <PROVIDER> matches a Provider.id in src/agent/providers/.
#
# Each provider is skipped independently when its pair is missing, so filling in
# only one of the four is perfectly fine.

# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Any tool-calling-capable model slug from https://openrouter.ai/models,
# e.g. openai/gpt-4o-mini. Double-check the exact slug on OpenRouter first —
# most non-first-party models need a provider prefix.
OPENROUTER_DEFAULT_MODEL=

# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# A tool-calling chat model, e.g. gpt-4o-mini. No provider prefix here — that's
# an OpenRouter convention, not OpenAI's.
OPENAI_DEFAULT_MODEL=

# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# A Claude model id from https://docs.anthropic.com/en/docs/about-claude/models
# — confirm the exact id there, since dated ids and `-latest` aliases differ.
ANTHROPIC_DEFAULT_MODEL=

# Get a key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# A Gemini model id *without* the `models/` prefix the API returns, e.g.
# gemini-2.5-flash. Check https://ai.google.dev/gemini-api/docs/models for
# current ids.
GOOGLE_DEFAULT_MODEL=
