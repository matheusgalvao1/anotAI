# Copy this file to .env and fill in your own values. .env is gitignored —
# never commit real keys.
#
# This is a dev/test-time convenience only (currently used by the OpenRouter
# live smoke test — see README.md, `npm run test:live`). The shipped app
# never reads API keys from env vars: user-supplied keys are stored in the
# OS keychain at runtime (PRD §8), never in a file.
#
# Naming convention, so this extends cleanly as more providers land (PRD
# §14.1): <PROVIDER>_API_KEY / <PROVIDER>_DEFAULT_MODEL, where <PROVIDER>
# matches a Provider.id in src/agent/providers/ (currently just OPENROUTER).

# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Any tool-calling-capable model slug from https://openrouter.ai/models,
# e.g. openai/gpt-4o-mini. Double-check the exact slug on OpenRouter first —
# most non-first-party models need a provider prefix.
OPENROUTER_DEFAULT_MODEL=
